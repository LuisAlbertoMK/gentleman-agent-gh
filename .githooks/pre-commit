#!/bin/sh
#
# Pre-commit hook — Gentleman Agent quality gate
# Runs automated checks on staged changes.
# Skippable with: git commit --no-verify
#

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -z "$REPO_ROOT" ] && REPO_ROOT="."

CHECKS_PASSED=0
CHECKS_FAILED=0

# --- Config: max warnings before blocking commit ---
MAX_ORTHO_WARNINGS=10

# --- Colored output ---
red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$1"; }

echo ""
echo "=== Gentleman Quality Gate ==="

# --- [1/9] Trailing whitespace check ---
echo "[1/9] Trailing whitespace..."
WHITESPACE_FILES=$(git diff --cached --check 2>&1 | grep -E "^[^+]" | head -20)
if [ -z "$WHITESPACE_FILES" ]; then
  green "  OK"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
  echo "$WHITESPACE_FILES" | while read -r line; do echo "  $line"; done
  yellow "  WARN — fix trailing whitespace before push"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [2/9] PS5.1 safety check on changed .ps1 files ---
echo "[2/9] PS5.1 safety (staged .ps1)..."
STAGED_PS1=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ps1$')
PS5_BLOCK=""
if [ -n "$STAGED_PS1" ]; then
  # Build file list for PowerShell byte-level detector (zero false positives)
  PS_ARGS=""
  FIRST=1
  for f in $STAGED_PS1; do
    FULL="$REPO_ROOT/$f"
    [ ! -f "$FULL" ] && continue
    case "$f" in *bash-safe*|*pssa-gate*) continue ;; esac
    # Escape single quotes for PowerShell
    ESCAPED=$(echo "$FULL" | sed "s/'/''/g")
    if [ $FIRST -eq 1 ]; then
      PS_ARGS="'$ESCAPED'"
      FIRST=0
    else
      PS_ARGS="$PS_ARGS, '$ESCAPED'"
    fi
  done
  HAZARD_FILES=""
  if [ -n "$PS_ARGS" ]; then
    HAZARD_FILES=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
      & '$REPO_ROOT/scripts/ps5-detect.ps1' -FilePath @($PS_ARGS)
    " 2>&1)
  fi
  if [ -z "$HAZARD_FILES" ]; then
    green "  OK"
  else
    red "  BLOCKING: PS5.1 hazard in: $HAZARD_FILES"
    echo "  PS5.1 does not support &&/||. Use: cmd1; if (\$?) { cmd2 }"
    PS5_BLOCK="yes"
  fi
else
  green "  OK (no .ps1 staged)"
fi
CHECKS_PASSED=$((CHECKS_PASSED + 1))

# --- [3/9] Cross-ref check on skill changes ---
echo "[3/9] Cross-ref check..."
STAGED_SKILLS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.agents/skills/' | head -3)
if [ -n "$STAGED_SKILLS" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/cross-ref-check.ps1" 2>&1
  if [ $? -eq 0 ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    red "  BLOCKING: cross-ref validation failed"
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
  fi
else
  green "  OK (no skill changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [4/9] Skill drift check on skill changes ---
echo "[4/9] Skill drift..."
if [ -n "$STAGED_SKILLS" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/check-skill-drift.ps1" 2>&1
  if [ $? -eq 0 ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    yellow "  WARN: skill drift detected (non-blocking)"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  fi
else
  green "  OK (no skill changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [5/9] Improvement cycle assessment ---
echo "[5/9] Improvement cycle..."
OVERWEIGHT_SKILLS=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
  \$canonical = \"$REPO_ROOT/.agents/skills\"
  if (-not (Test-Path \$canonical)) { exit 0 }
  Get-ChildItem \$canonical -Directory | Where-Object { \$_.Name -ne '_shared' } | ForEach-Object {
    \$md = Join-Path \$_.FullName 'SKILL.md'
    if (Test-Path \$md) {
      \$len = (Get-Content \$md -Raw).Length
      if (\$len -gt 3072) { Write-Output \"\$(\$_.Name) (\$(\$len)B)\" }
    }
  }
" 2>&1)
if [ -n "$OVERWEIGHT_SKILLS" ]; then
  yellow "  WARN — skills >3KB (consider improvement cycle):"
  echo "$OVERWEIGHT_SKILLS" | while read -r line; do echo "    $line"; done
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
  if [ -n "$STAGED_SKILLS" ]; then
    green "  OK (all skills ≤3KB)"
  else
    green "  OK (no skill changes)"
  fi
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [6/9] .project.json integrity check ---
echo "[6/9] .project.json integrity..."
STAGED_PROJECT_JSON=$(git diff --cached --name-only --diff-filter=ACM | grep '\.project\.json$')
if [ -n "$STAGED_PROJECT_JSON" ]; then
  POWERSHELL_OUT=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
    \$json = Get-Content '$REPO_ROOT/.project.json' -Raw -Encoding UTF8 | ConvertFrom-Json
    \$dims = \$json.score.dimensions.PSObject.Properties.Name.Count
    \$current = \$json.score.current
    if (\$dims -ne 13) { Write-Output \"FAIL: Expected 13 dimensions, found \$dims\" }
    if (\$current -eq \$null -or \$current -lt 5) { Write-Output \"FAIL: score.current missing or < 5\" }
  " 2>&1)
  if [ -z "$POWERSHELL_OUT" ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    red "  BLOCKING: .project.json validation failed"
    echo "$POWERSHELL_OUT" | while read -r line; do echo "    $line"; done
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
  fi
else
  green "  OK (no .project.json changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [7/9] review-rules.jsonc integrity (if changed) ---
echo "[7/9] review-rules.jsonc integrity..."
STAGED_RULES=$(git diff --cached --name-only --diff-filter=ACM | grep 'review-rules\.jsonc$')
if [ -n "$STAGED_RULES" ]; then
  RULES_VALID=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
    try {
      \$json = Get-Content '$REPO_ROOT/review-rules.jsonc' -Raw -Encoding UTF8
      \$parsed = \$json -replace '(?m)^\s*//.*$','' -replace '(?m)\s*//[^\"\n]*$','' -replace '(?s)/\*.*?\*/','' | ConvertFrom-Json
      \$zones = \$parsed.zones.PSObject.Properties.Name
      \$ctx = \$parsed.context_zones.PSObject.Properties.Name
      \$modes = \$parsed.modes.PSObject.Properties.Name
      \$profiles = \$parsed.jd_profiles.PSObject.Properties.Name
      \$selector = \$parsed.jd_profile_selector
      if (\$zones.Count -ne 3) { Write-Output \"FAIL: Expected 3 zones, found \$(\$zones.Count): \$(\$zones -join ',')\" }
      if (\$ctx.Count -ne 4) { Write-Output \"FAIL: Expected 4 context zones, found \$(\$ctx.Count): \$(\$ctx -join ',')\" }
      if (\$modes.Count -ne 4) { Write-Output \"FAIL: Expected 4 modes, found \$(\$modes.Count): \$(\$modes -join ',')\" }
      if (\$profiles.Count -lt 1) { Write-Output \"FAIL: Expected >=1 jd_profiles, found \$(\$profiles.Count)\" }
      if (\$selector.Count -lt 1) { Write-Output \"FAIL: Expected >=1 jd_profile_selector, found \$(\$selector.Count)\" }
      Write-Output \"OK zones=\$(\$zones -join ',') ctx=\$(\$ctx -join ',') modes=\$(\$modes -join ',') profiles=\$(\$profiles.Count) selectors=\$(\$selector.Count)\"
    } catch {
      Write-Output \"FAIL: Parse error - \$(\$_.Exception.Message)\"
    }
  " 2>&1)
  if echo "$RULES_VALID" | grep -q "^OK"; then
    green "  OK"
    echo "  $RULES_VALID" | head -1
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    red "  BLOCKING: review-rules.jsonc validation failed"
    echo "$RULES_VALID" | while read -r line; do echo "    $line"; done
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
  fi
else
  green "  OK (no review-rules.jsonc changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [8/9] Benchmark check (on skill or AGENTS.md changes) ---
echo "[8/9] Benchmark check..."
STAGED_AGENTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'AGENTS\.md|\.agents/skills/')
if [ -n "$STAGED_AGENTS" ]; then
  BENCHMARK_OUT=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/benchmark.ps1" -Gate 2>&1)
  if echo "$BENCHMARK_OUT" | grep -q "REGRESSIONS"; then
    yellow "  WARN — benchmark regressions detected:"
    echo "$BENCHMARK_OUT" | while read -r line; do echo "    $line"; done
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    echo "$BENCHMARK_OUT" | head -3
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  fi
else
  green "  OK (no skill/AGENTS.md changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [9/9] JD review check (ROJA zone files) ---
echo "[9/9] JD review check (ROJA zone)..."
STAGED_ROJA=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(src/|test/|scripts/|migrations/|ci/|\.github/)' | head -10)
if [ -n "$STAGED_ROJA" ]; then
  yellow "  WARN — ROJA zone files staged without JD dual review:"
  echo "$STAGED_ROJA" | while read -r line; do echo "    $line"; done
  echo "  Run 'judgment-day' or review-pipeline before !ship"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
  green "  OK (no ROJA files staged)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- Summary ---
echo ""
TOTAL=$((CHECKS_PASSED + CHECKS_FAILED))
echo "=== Gate: $CHECKS_PASSED/$TOTAL passed ==="
BLOCKED="no"
if [ $CHECKS_FAILED -gt 0 ] || [ -n "$PS5_BLOCK" ]; then
  BLOCKED="yes"
  red "  BLOCKED: fix errors above and stage again"
else
  green "  ALL CLEAR"
fi

# --- Capture gate result to error tracking (non-blocking, silent) ---
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
  & '$REPO_ROOT/scripts/capture-errors.ps1' -Source quality-gate -Passed $CHECKS_PASSED -Failed $CHECKS_FAILED -Blocked '$BLOCKED'
" > /dev/null 2>&1

if [ "$BLOCKED" = "yes" ]; then
  exit 1
else
  exit 0
fi
