#!/bin/sh
#
# Pre-commit hook — Gentleman Agent quality gate
# Runs automated checks on staged changes.
# Skippable with: git commit --no-verify
#

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -z "$REPO_ROOT" ] && REPO_ROOT="."

CHECKS_PASSED=0
CHECKS_FAILED=0

# --- Config: max warnings before blocking commit ---
MAX_ORTHO_WARNINGS=10

# --- Colored output ---
red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$1"; }

echo ""
echo "=== Gentleman Quality Gate ==="

# --- [1/4] Trailing whitespace check ---
echo "[1/4] Trailing whitespace..."
WHITESPACE_FILES=$(git diff --cached --check 2>&1 | grep -E "^[^+]" | head -20)
if [ -z "$WHITESPACE_FILES" ]; then
  green "  OK"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
  echo "$WHITESPACE_FILES" | while read -r line; do echo "  $line"; done
  yellow "  WARN — fix trailing whitespace before push"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [2/4] PS5.1 safety check on changed .ps1 files ---
echo "[2/4] PS5.1 safety (staged .ps1)..."
STAGED_PS1=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ps1$')
if [ -n "$STAGED_PS1" ]; then
  HAZARD_FILES=""
  for f in $STAGED_PS1; do
    FULL="$REPO_ROOT/$f"
    [ ! -f "$FULL" ] && continue
    # Skip bash-safe.ps1 — it intentionally contains &&/|| in strings
    case "$f" in *bash-safe*) continue ;; esac
    # Check for && and || operators outside comment lines
    if grep -nE '(^|[^=])\&\&([^=]|$)' "$FULL" 2>/dev/null | grep -v '^[0-9]*:#' | head -5 >/dev/null; then
      HAZARD_FILES="$HAZARD_FILES $f(&&)"
    fi
    if grep -nE '(^|[^=])\|\|([^=]|$)' "$FULL" 2>/dev/null | grep -v '^[0-9]*:#' | head -5 >/dev/null; then
      HAZARD_FILES="$HAZARD_FILES $f(||)"
    fi
  done
  if [ -z "$HAZARD_FILES" ]; then
    green "  OK"
  else
    yellow "  WARN: PS5.1 hazard detected in:$HAZARD_FILES"
    echo "  PowerShell 5.1 does not support && or ||. Use: cmd1; if (\$?) { cmd2 }"
  fi
else
  green "  OK (no .ps1 staged)"
fi
CHECKS_PASSED=$((CHECKS_PASSED + 1))

# --- [3/4] Cross-ref check on skill changes ---
echo "[3/4] Cross-ref check..."
STAGED_SKILLS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.agents/skills/' | head -3)
if [ -n "$STAGED_SKILLS" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/cross-ref-check.ps1" 2>&1
  if [ $? -eq 0 ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    red "  BLOCKING: cross-ref validation failed"
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
  fi
else
  green "  OK (no skill changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [4/4] Skill drift check on skill changes ---
echo "[4/4] Skill drift..."
if [ -n "$STAGED_SKILLS" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/check-skill-drift.ps1" 2>&1
  if [ $? -eq 0 ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    yellow "  WARN: skill drift detected (non-blocking)"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  fi
else
  green "  OK (no skill changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- Summary ---
echo ""
TOTAL=$((CHECKS_PASSED + CHECKS_FAILED))
echo "=== Gate: $CHECKS_PASSED/$TOTAL passed ==="
if [ $CHECKS_FAILED -gt 0 ]; then
  red "  BLOCKED: fix errors above and stage again"
  exit 1
else
  green "  ALL CLEAR"
  exit 0
fi
