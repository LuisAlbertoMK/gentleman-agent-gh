#!/bin/sh
#
# Pre-commit hook — Gentleman Agent quality gate
# Runs automated checks on staged changes.
# Skippable with: git commit --no-verify
#

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
[ -z "$REPO_ROOT" ] && REPO_ROOT="."

CHECKS_PASSED=0
CHECKS_FAILED=0

# --- Config: max warnings before blocking commit ---
MAX_ORTHO_WARNINGS=10

# --- Colored output ---
red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
yellow(){ printf '\033[33m%s\033[0m\n' "$1"; }

echo ""
echo "=== Gentleman Quality Gate ==="

# --- [1/4] Trailing whitespace check ---
echo "[1/5] Trailing whitespace..."
WHITESPACE_FILES=$(git diff --cached --check 2>&1 | grep -E "^[^+]" | head -20)
if [ -z "$WHITESPACE_FILES" ]; then
  green "  OK"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
  echo "$WHITESPACE_FILES" | while read -r line; do echo "  $line"; done
  yellow "  WARN — fix trailing whitespace before push"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [2/4] PS5.1 safety check on changed .ps1 files ---
echo "[2/5] PS5.1 safety (staged .ps1)..."
STAGED_PS1=$(git diff --cached --name-only --diff-filter=ACM | grep '\.ps1$')
PS5_BLOCK=""
if [ -n "$STAGED_PS1" ]; then
  # Build file list for PowerShell byte-level detector (zero false positives)
  PS_ARGS=""
  FIRST=1
  for f in $STAGED_PS1; do
    FULL="$REPO_ROOT/$f"
    [ ! -f "$FULL" ] && continue
    case "$f" in *bash-safe*) continue ;; esac
    # Escape single quotes for PowerShell
    ESCAPED=$(echo "$FULL" | sed "s/'/''/g")
    if [ $FIRST -eq 1 ]; then
      PS_ARGS="'$ESCAPED'"
      FIRST=0
    else
      PS_ARGS="$PS_ARGS, '$ESCAPED'"
    fi
  done
  HAZARD_FILES=""
  if [ -n "$PS_ARGS" ]; then
    HAZARD_FILES=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
      & '$REPO_ROOT/scripts/ps5-detect.ps1' -FilePath @($PS_ARGS)
    " 2>&1)
  fi
  if [ -z "$HAZARD_FILES" ]; then
    green "  OK"
  else
    red "  BLOCKING: PS5.1 hazard in: $HAZARD_FILES"
    echo "  PS5.1 does not support &&/||. Use: cmd1; if (\$?) { cmd2 }"
    PS5_BLOCK="yes"
  fi
else
  green "  OK (no .ps1 staged)"
fi
CHECKS_PASSED=$((CHECKS_PASSED + 1))

# --- [3/5] Cross-ref check on skill changes ---
echo "[3/5] Cross-ref check..."
STAGED_SKILLS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.agents/skills/' | head -3)
if [ -n "$STAGED_SKILLS" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/cross-ref-check.ps1" 2>&1
  if [ $? -eq 0 ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    red "  BLOCKING: cross-ref validation failed"
    CHECKS_FAILED=$((CHECKS_FAILED + 1))
  fi
else
  green "  OK (no skill changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [4/5] Skill drift check on skill changes ---
echo "[4/5] Skill drift..."
if [ -n "$STAGED_SKILLS" ]; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO_ROOT/scripts/check-skill-drift.ps1" 2>&1
  if [ $? -eq 0 ]; then
    green "  OK"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  else
    yellow "  WARN: skill drift detected (non-blocking)"
    CHECKS_PASSED=$((CHECKS_PASSED + 1))
  fi
else
  green "  OK (no skill changes)"
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- [5/5] Improvement cycle assessment ---
echo "[5/5] Improvement cycle..."
OVERWEIGHT_SKILLS=$(powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
  \$canonical = \"$REPO_ROOT/.agents/skills\"
  if (-not (Test-Path \$canonical)) { exit 0 }
  Get-ChildItem \$canonical -Directory | Where-Object { \$_.Name -ne '_shared' } | ForEach-Object {
    \$md = Join-Path \$_.FullName 'SKILL.md'
    if (Test-Path \$md) {
      \$len = (Get-Content \$md -Raw).Length
      if (\$len -gt 3072) { Write-Output \"\$(\$_.Name) (\$(\$len)B)\" }
    }
  }
" 2>&1)
if [ -n "$OVERWEIGHT_SKILLS" ]; then
  yellow "  WARN — skills >3KB (consider improvement cycle):"
  echo "$OVERWEIGHT_SKILLS" | while read -r line; do echo "    $line"; done
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
else
  if [ -n "$STAGED_SKILLS" ]; then
    green "  OK (all skills ≤3KB)"
  else
    green "  OK (no skill changes)"
  fi
  CHECKS_PASSED=$((CHECKS_PASSED + 1))
fi

# --- Summary ---
echo ""
TOTAL=$((CHECKS_PASSED + CHECKS_FAILED))
echo "=== Gate: $CHECKS_PASSED/$TOTAL passed ==="
if [ $CHECKS_FAILED -gt 0 ] || [ -n "$PS5_BLOCK" ]; then
  red "  BLOCKED: fix errors above and stage again"
  exit 1
else
  green "  ALL CLEAR"
  exit 0
fi
