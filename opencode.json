  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "C:\\Users\\MK\\AppData\\Local\\engram\\bin\\engram.exe",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git push --delete *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git merge *": "ask",
      "git branch -D *": "ask",
      "git stash drop *": "ask",
      "gh pr merge *": "ask"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  }
}