{
  "skills": {
    "paths": [
      ".agents/skills/*"
    ]
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git push --force *": "ask",
      "git push --delete *": "ask",
      "git rebase *": "ask",
      "git reset *": "ask",
      "git merge *": "ask",
      "git branch -D *": "ask",
      "git stash drop *": "ask",
      "gh pr merge *": "ask",
      "rm *": "deny",
      "rm -rf *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "Invoke-WebRequest *": "deny",
      "Invoke-RestMethod *": "deny",
      "Invoke-Expression *": "deny",
      "irm *": "deny",
      "iwr *": "deny",
      "iex *": "deny",
      "Remove-Item *": "deny",
      "Start-BitsTransfer *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "telnet *": "deny",
      "Test-NetConnection *": "deny",
      "cmd /c *": "deny",
      "powershell -c *": "deny",
      "powershell -command *": "deny",
      "Start-Process *": "deny",
      "Invoke-Command *": "deny",
      "Register-ScheduledTask *": "deny",
      "New-Service *": "deny",
      "sc *": "deny",
      "reg *": "deny",
      "Add-MpPreference *": "deny",
      "Set-MpPreference *": "deny",
      "schtasks *": "deny",
      "icacls *": "deny",
      "net user *": "deny",
      "net localgroup *": "deny",
      "net share *": "deny",
      "net use *": "deny",
      "net session *": "deny",
      "cmd.exe *": "deny",
      "icm *": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/.ssh/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.docker/config.json": "deny",
      "**/.aws/credentials": "deny",
      "**/.azure/accessTokens": "deny",
      "**/.gnupg/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env*": "deny",
      "**/.kube/config": "deny",
      "**/.config/gh/**": "deny",
      "**/.m2/**": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/*.gpg": "deny",
      "**/.boto": "deny"
    },
    "write": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/.ssh/**": "deny",
      "**/*.key": "deny",
      "**/*.pem": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.docker/config.json": "deny",
      "**/.aws/credentials": "deny",
      "**/.azure/accessTokens": "deny",
      "**/.gnupg/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env*": "deny",
      "opencode.json": "deny",
      "AGENTS.md": "deny",
      "prompts/**/*": "deny",
      ".agents/**/*": "deny",
      "**/.kube/config": "deny",
      "**/.config/gh/**": "deny",
      "**/.m2/**": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/*.gpg": "deny",
      "**/.boto": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env*": "deny",
      "**/credentials.json": "deny",
      "**/secrets/**": "deny",
      "**/*secret*": "deny",
      "**/.ssh/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env*": "deny",
      "opencode.json": "deny",
      "AGENTS.md": "deny",
      "prompts/**/*": "deny",
      ".agents/**/*": "deny",
      "**/.kube/config": "deny",
      "**/.config/gh/**": "deny",
      "**/.m2/**": "deny",
      "**/*.jks": "deny",
      "**/*.keystore": "deny",
      "**/*.gpg": "deny",
      "**/.boto": "deny"
    }
  },
  "default_agent": "gentleman-vMK",
  "experimental": {
    "mcp_timeout": 60000
  },
  "compaction": {
    "prune": true,
    "reserved": 8000
  },
  "tools": {
    "codebase-memory*": false,
    "engram*": false
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "codebase-memory-mcp"
      ],
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "CBM_ALLOWED_ROOT": "D:\\gentleman-agent-gh"
      }
    },
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "enabled": true,
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local",
      "timeout": 30000
    },
    "headroom": {
      "enabled": false,
      "type": "local",
      "command": [
        "headroom",
        "mcp",
        "serve"
      ],
      "environment": {
        "HEADROOM_PROXY_URL": "{env:HEADROOM_PROXY_URL}"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "gentleman-vMK": {
      "description": "Orchestrator - decomposes tasks, delegates to right agent, synthesizes results. Never implements directly.",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-vMK.md}\n\n{file:prompts/shared/_core-behavior-gp.md}",
      "tools": {
        "codebase-memory*": true,
        "engram*": true
      }
    },
    "gentleman-deep": {
      "description": "Deep reasoning - hypothesis-driven debugging, root cause analysis, multi-file refactors with impact analysis",
      "model": "opencode/nemotron-3-ultra-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-deep.md}\n\n{file:prompts/shared/_core-behavior-gp.md}",
      "tools": {
        "codebase-memory*": true,
        "engram*": true
      }
    },
    "gentleman-quick": {
      "description": "Fast executor - single-file atomic edits with immediate verification, scope-guarded",
      "model": "opencode/mimo-v2.5-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-quick.md}\n\n{file:prompts/shared/_core-behavior-gp.md}"
    },
    "gentleman-codex": {
      "description": "Code generation - convention mirroring, defensive coding, new files/scripts/boilerplate",
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-codex.md}\n\n{file:prompts/shared/_core-behavior-gp.md}"
    },
    "gentleman-security": {
      "description": "Security specialist - STRIDE threat model, CVSS scoring, OWASP Top 10, injection/XSS/auth analysis (FREE TIER)",
      "model": "opencode/nemotron-3-ultra-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-security.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-seo": {
      "description": "Technical SEO analyst - three-pillar audit (Technical/On-Page/Content), E-E-A-T, GEO readiness, schema validation (FREE TIER)",
      "model": "opencode/nemotron-3-super-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-seo.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-infra": {
      "description": "Infrastructure specialist - container security, K8s reliability, IaC quality, CI/CD security, dependency graphs (FREE TIER)",
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-infra.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-frontend": {
      "description": "Frontend auditor - WCAG 2.2 AA (POUR), component architecture, design tokens, performance indicators (FREE TIER)",
      "model": "opencode/kimi-k2.5-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-frontend.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-performance": {
      "description": "Performance specialist - Amdahl's Law, code complexity, N+1 detection, memory analysis, profiling-driven optimization (FREE TIER)",
      "model": "opencode/nemotron-3-ultra-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-performance.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-datascience": {
      "description": "Data science specialist - data quality framework, anti-patterns (apply/iterrows), SQL audit, statistical validity (FREE TIER)",
      "model": "opencode/mimo-v2.5-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-datascience.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-docs": {
      "description": "Documentation specialist - Diátaxis framework, completeness audit, content quality, cognitive load analysis (FREE TIER)",
      "model": "opencode/big-pickle",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-docs.md}\n\n{file:prompts/shared/_analyze-only-protocol.md}"
    },
    "gentleman-implementer": {
      "description": "Plan executor specialist — implements plans from specialized agents, no deviations (FREE TIER)",
      "model": "opencode/deepseek-v4-flash-free",
      "mode": "primary",
      "prompt": "{file:prompts/gentleman-implementer.md}\n\n{file:prompts/shared/_core-behavior-gp.md}"
    },
    "sdd-apply": {
      "description": "Implement code changes from task definitions",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-apply.md}"
    },
    "sdd-archive": {
      "description": "Archive completed change artifacts",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-archive.md}"
    },
    "sdd-design": {
      "description": "Create technical design from proposals",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-design.md}"
    },
    "sdd-explore": {
      "description": "Investigate codebase and think through ideas",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-explore.md}"
    },
    "sdd-init": {
      "description": "Bootstrap SDD context and project configuration",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-init.md}"
    },
    "sdd-orchestrator": {
      "description": "SDD Orchestrator - coordinates sub-agents, never does work inline",
      "model": "claude-sonnet-4-6",
      "mode": "primary",
      "prompt": "{file:prompts/sdd/sdd-orchestrator.md}"
    },
    "sdd-propose": {
      "description": "Create change proposals from explorations",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-propose.md}"
    },
    "sdd-spec": {
      "description": "Write detailed specifications from proposals",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-spec.md}"
    },
    "sdd-tasks": {
      "description": "Break down specs and designs into implementation tasks",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-tasks.md}"
    },
    "sdd-verify": {
      "description": "Validate implementation against specs",
      "hidden": true,
      "mode": "subagent",
      "prompt": "{file:prompts/sdd/sdd-verify.md}"
    }
  },
  "plugin": [
    "context-mode",
    "opencode-ralph-loop",
    "opencode-lazy-loader",
    "opencode-personality"
  ]
}
