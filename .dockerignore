# Version control
.git
.gitignore

# Dependencies (rebuilt in container)
node_modules
package-lock.json

# Learnings and session data
.learnings

# Tests and test artifacts
scripts/tests
*.Tests.ps1
*.test.js
*.test.jsx

# Documentation (not needed in runtime)
docs
*.md
!README.md

# CI/CD and config
.github
.pre-commit-config.yaml
.gitleaks.toml
.editorconfig

# IDE
.vscode
.idea

# OS files
.DS_Store
Thumbs.db

# Dev containers
.devcontainer

# Examples
examples

# Metric snapshots
docs/metricas/snapshots

# Secrets and credentials — prevent leaks into image layers
.env*
*.pem
*.key
*.p12
secrets/

# Logs
*.log

# Data (extracted from scripts, rebuilt in CI)
data/

# opnecode runtime config
.opencode/

# Mode state
.gentleman-mode

# Git hooks (local dev only)
.githooks/
.gitattributes

