{
  "name": "Gentleman Agent",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "ms-python.python",
        "ms-vscode.vscode-typescript-next"
      ],
      "settings": {
        "powershell.codeFormatting.preset": "OTBS",
        "editor.formatOnSave": true
      }
    }
  },
  "remoteUser": "vscode"
}
