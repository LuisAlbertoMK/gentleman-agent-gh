# ============================================
# Gentleman Agent — .gitignore
# ============================================

# OS
Thumbs.db
.DS_Store
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# ============================================
# Working artifacts (NOT for distribution)
# ============================================
# Metrics, backups, and runtime state.
# Live state is at C:\Users\MK\.config\opencode\

.metricas/
.bak/
.backup/
*.backup
*.pre-*

# Local scripts
scripts/*.local.ps1
scripts/*.local.sh
scripts/.env

# ============================================
# Temp / scratch
# ============================================
tmp/
temp/
scratch/
*.log
logs/

# ============================================
# Node (if user adds Node tooling later)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
.npm/

# ============================================
# Build artifacts (defensive — not used yet)
# ============================================
dist/
build/
out/
.next/
.cache/
coverage/
.parcel-cache/
.turbo/
*.tsbuildinfo

# ============================================
# Engram runtime data (if symlinked here)
# ============================================
*.engram/
.engram-cache/

# ============================================
# Secrets (defensive)
# ============================================
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
