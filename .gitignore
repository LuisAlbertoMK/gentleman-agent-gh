# ============================================
# Gentleman Agent — .gitignore
# ============================================

# OS
Thumbs.db
.DS_Store
Desktop.ini
ehthumbs.db
ehthumbs_vista.db

# Screenshots / debug images
*.png
*.jpg
*.jpeg

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig
*.rej

# ============================================
# Working artifacts (NOT for distribution)
# ============================================
# Metrics, backups, and runtime state.
# Live state is at $env:USERPROFILE\.config\opencode\

.metricas/
.bak/
backups/
temp_code_clean/

# Generated error snapshots (regenerated by capture-errors.ps1 on every commit)
docs/metricas/errors/LATEST_error.json
docs/metricas/snapshots/LATEST_benchmark.json
.atl/
.backup/
*.backup
backups/
*.pre-*

# ============================================
# Skills workspace (all junctions → .agents/skills/)
# Canonical source: .agents/skills/ is git-tracked
# ============================================
/skills/

# Local scripts
scripts/*.local.ps1
scripts/*.local.sh
scripts/.env

# ============================================
# Temp / scratch
# ============================================
# Stray PowerShell redirect targets (broken `> $null` writes)
$null
_testrun.log
_toolout.log
_toolout2.log
_toolout*.log
tmp/
temp/
scratch/
*.log
logs/
score-debug.json

# ============================================
# Node (if user adds Node tooling later)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ============================================
# Build artifacts (defensive �?" not used yet)
# ============================================
dist/
build/
out/
.next/
.cache/
coverage/
coverage.xml
.parcel-cache/
.turbo/
*.tsbuildinfo

# Go compiled binaries — build artifacts, do NOT commit. Rebuild from source:
#   go build -o bin/fast.exe ./cmd/fast
gentle-batch-edit.exe
bin/*.exe

# Generated reports
docs/health-report.html

# ============================================
# Engram runtime data (if symlinked here)
# ============================================
*.engram/
.engram-cache/

# ============================================
# Self-improving agent (learnings dirs)
# ============================================
.learnings/*
!.learnings/engram-sync.json
.learnings/engram-batch.json

# ============================================
# Plugin: opencode-self-improve config
# ============================================
magic-context.jsonc

# ============================================
# Local user profiles (self-improving-agent)
# ============================================
*.local.md

# ============================================
# Secrets (defensive)
# ============================================
.env
.env.*
*.pem
*.key
secrets/
credentials.json

# SkillSpector clone (upstream NVIDIA)
.skillspector/

# Skill registry (auto-generated)
scripts/skill-registry.json.backup-session-*/
scripts/skill-registry.json
.backup-session-20260705-150321/

# Pester test results
TestResults.xml

# Archived stale documentation
.archive/

# JD review clearance markers — run `!judgment-day` then touch .jd-cleared/<path>
# (path separators become underscores; scripts/foo.ps1 -> .jd-cleared/scripts_foo.ps1)
.jd-cleared/*
!.jd-cleared/.gitkeep

# Adversarial-breaker clearance markers — check [23/26] pre-commit gate
# (path separators become underscores; scripts/foo.ps1 -> .breaker-cleared/scripts_foo.ps1)
.breaker-cleared/*
!.breaker-cleared/.gitkeep
docs/ciclos/c28-w2-backup/

# C1 cross-ref integrity artifacts
cross-ref-output.json
score-output.json
sync-vmk-output.txt

# Pester coverage output (generated by quality-gate tests job)
scripts/tests/_coverage/

# MK local backup (not tracked)
docs/compar_code.zip
docs/compar_code/

# ============================================
# Session checkpoints (runtime, not tracked)
# ============================================
.opencode/session-checkpoints/
.opencode/session-checkpoints/*.json
docs/agentes/*/05-implementacion-completada.md

# Local-only fix artifacts (cross-machine transfer, never commit)
reparar/

# Playwright artifacts
test-results/

# Crush local artifacts
.crush/crush.db*
.crush/logs/
/.crushrc
