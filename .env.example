# Gentleman Agent — Environment Variables
# Copy to .env and customize. All are OPTIONAL.

# ── Agent Root ───────────────────────────────────────────────────────────
# Auto-detected from junction. Only set if you need to override.
# GENTLEMAN_AGENT_ROOT=D:\gentleman-agent-gh

# ── Gentle AI (install.ps1) ─────────────────────────────────────────────
# GENTLE_AI_CHANNEL=stable        # stable | beta | nightly
# GENTLE_AI_NO_SELF_UPDATE=1      # Set to 1 to disable self-update checks

# ── Path Extensions ──────────────────────────────────────────────────────
# The run.ps1 and ensure-tools.ps1 add paths to %PATH% automatically.
# Custom PATH additions can go here.
# PATH=%PATH%;C:\custom-tools

# ── Profile ──────────────────────────────────────────────────────────────
# Also loaded from .config/opencode/profile.ps1 (see AGENTS.md)
# PLATFORM=win32
# SHELL=pwsh
